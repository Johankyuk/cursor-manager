[Desktop Entry]
Type=Application
Version=1.0
Name=Escala del cursor
GenericName=Cursor manager
Comment=Cambiar tamaño y tema del cursor, e instalar temas nuevos
# Depende de que ~/.local/bin esté en el PATH de la sesión gráfica.
# install.sh lo garantiza vía ~/.config/environment.d/10-path.conf.
# Alternativa que no depende del PATH, si tu launcher no lo resuelve:
#   Exec=foot --app-id=cursor-scale sh -c "exec \\$HOME/.local/bin/cursor-scale"
Exec=foot --app-id=cursor-scale --title=cursor-scale --window-size-pixels=680x360 cursor-scale
Icon=input-mouse
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=cursor;mouse;raton;escala;scale;size;puntero;xcursor;tema;theme;
StartupNotify=false
StartupWMClass=cursor-scale
