[Desktop Entry]
Type=Application
Version=1.0
Name=Escala del cursor
GenericName=Cursor manager
Comment=Cambiar tamaño y tema del cursor, e instalar temas nuevos
# Ruta vía $HOME en vez de confiar en el PATH: el compositor puede arrancar
# desde el greeter por PAM y no heredar el entorno del manager de usuario,
# con lo cual ~/.local/bin no está en el PATH de lo que lance el launcher.
# El doble backslash es el escapado del formato .desktop: el archivo
# desescapa \\ a \, y el parser de Exec entrega `exec $HOME/...` a sh -c.
Exec=foot --app-id=cursor-scale --title=cursor-scale --window-size-pixels=680x360 sh -c "exec \\$HOME/.local/bin/cursor-scale"
Icon=input-mouse
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=cursor;mouse;raton;escala;scale;size;puntero;xcursor;tema;theme;
StartupNotify=false
StartupWMClass=cursor-scale
